# Normalize text to LF in the repo, CRLF in the working tree; eol=crlf matches
# this project's Windows / MPLAB X convention.
* text=auto eol=crlf

# Binary assets/outputs (never EOL-converted)
*.png binary
*.jpg binary
*.svg binary
*.hex binary
*.elf binary
*.o   binary
*.a   binary
*.X.a binary
*.bin binary
*.wav binary
*.exe binary
*.uf2 binary

# MPLAB X / build-tool-generated files: byte-exact, let the tool be EOL king.
# Must come AFTER the general rule above (last-match-wins).
**/nbproject/*.mk                       -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/nbproject/Makefile-*                 -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/nbproject/configurations.xml         -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/nbproject/private/configurations.xml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
**/nbproject/project.xml                -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Development-tree-only material, kept out of the public source snapshot
